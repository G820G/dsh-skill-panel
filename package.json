{
  "name": "dsh-skill-panel",
  "version": "1.0.0",
  "description": "Left-panel skill browser and composer skill picker for DeepSeek Harness.",
  "type": "module",
  "license": "MIT",
  "author": "G820G",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "cordis",
    "skills",
    "web-ui"
  ],
  "homepage": "https://github.com/G820G/dsh-skill-panel#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/G820G/dsh-skill-panel.git"
  },
  "bugs": {
    "url": "https://github.com/G820G/dsh-skill-panel/issues"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "docs",
    "icon.svg",
    "README*"
  ],
  "engines": {
    "dsh": ">=0.2.2-rc.3 <0.3.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "compatibility": {
      "dshReleases": {
        "0.2.2-rc.3": "compatible"
      }
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}
